{
  "channel": "van-vat",
  "fonts": {
    "headline": {
      "preferred": "Source Serif 4, serif",
      "alternatives": "Lora, serif"
    },
    "largeExplanatory": {
      "preferred": "Inter, sans-serif",
      "alternatives": "Manrope, sans-serif"
    },
    "body": {
      "preferred": "Inter, sans-serif",
      "alternatives": "IBM Plex Sans, sans-serif"
    },
    "scientific": {
      "preferred": "IBM Plex Mono, monospace",
      "alternatives": "Roboto Mono, monospace"
    }
  },
  "scale": {
    "heroHeadline": {
      "fontSize": "88-112px",
      "lineHeight": "0.98-1.12",
      "fontWeight": "600-700",
      "guidance": "Editorial, short, 2-4 lines"
    },
    "sectionStatement": {
      "fontSize": "62-80px",
      "fontWeight": "600-700",
      "guidance": "A question, discovery, or core concept"
    },
    "bodyExplanation": {
      "fontSize": "38-48px",
      "lineHeight": "1.3-1.5",
      "fontWeight": "400-500",
      "guidance": "Short, digestible lines"
    },
    "figureLabel": {
      "fontSize": "28-36px",
      "fontWeight": "450-600",
      "guidance": "Clear scientific naming"
    },
    "measurementMetadata": {
      "fontSize": "22-28px",
      "fontWeight": "500-600",
      "guidance": "Unit, scale, classification, source"
    },
    "subtitles": {
      "fontSize": "44-54px",
      "fontWeight": "500-600",
      "guidance": "Maximum 2 lines"
    }
  }
}